# ============================================================================
#  Casino Royale - variables de entorno
# ============================================================================
#  Copia este fichero a .env.local para desarrollo y pega los mismos valores en
#  el panel de Vercel para producción.
#
#  .env.local está en .gitignore. No lo subas nunca a GitHub.
# ============================================================================

# ---------------------------------------------------------------- PÚBLICAS --
# Todo lo que empieza por NEXT_PUBLIC_ acaba dentro del JavaScript del
# navegador. Aquí no va ningún secreto.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...la-clave-anon-publica...

NEXT_PUBLIC_SITE_URL=https://casinoroyale.example
NEXT_PUBLIC_CHANNEL=production
NEXT_PUBLIC_IOS_APP_STORE_URL=
NEXT_PUBLIC_GITHUB_REPO=tu-usuario/casino-royale

# ---------------------------------------------------------------- SECRETAS --
# Solo servidor. Si alguna de estas aparece en el navegador, está mal puesta.

# Supabase > Settings > API > service_role. Se salta TODAS las reglas de
# seguridad: trátala como la contraseña de la base de datos, porque lo es.
SUPABASE_SERVICE_ROLE_KEY=eyJ...la-clave-service-role...

# Secreto compartido con el cron de GitHub Actions que evita que el proyecto
# gratuito de Supabase se pause. Invéntate una cadena larga y aleatoria.
CRON_SECRET=

# ------------------------------------------------------------------ BOTS --
# Jugadores bot (lib/bots). Sin BOTS_ENABLED=true no hace NADA. Requiere
# backend/17_bots.sql y que algo mueva a los bots: el cron de
# /api/cron/bots (cada minuto, con CRON_SECRET) o `npm run bots:worker`.
BOTS_ENABLED=false
BOTS_MIN_ONLINE=3
BOTS_MAX_ONLINE=50
BOTS_ALLOW_EVENTS=true
BOTS_ALLOW_1V1=true
BOTS_ALLOW_HUMAN_1V1=true
BOTS_IN_LEADERBOARD=true
# Opcionales:
# BOTS_POOL_SIZE=80
# BOTS_TIMEZONE=Europe/Madrid
# BOTS_TICK_BUDGET_SECONDS=50
# BOTS_SCHEDULE=[{"from":0,"to":8,"min":3,"max":10},{"from":8,"to":24,"min":10,"max":40}]
